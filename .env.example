# OpenResearch Environment Variables
# Copy this file to .env and fill in your keys

# Default LLM Provider: openai, anthropic, openrouter, lmstudio, ollama
OPENRESEARCH_PROVIDER=openai

# Provider API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Provider Base URLs (leave default unless using a proxy or local server)
#OPENAI_BASE_URL=https://api.openai.com/v1
#ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Default Models (optional)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
LMSTUDIO_MODEL=local-model
OLLAMA_MODEL=llama3.1:8b

# Search APIs
TAVILY_API_KEY=tvly-your-tavily-key-here
SERPAPI_KEY=your-serpapi-key-here

# Search Provider Preference: tavily (requires TAVILY_API_KEY) or serpapi (requires SERPAPI_KEY)
# Falls back to no-op search if neither is set
SEARCH_PROVIDER=tavily
